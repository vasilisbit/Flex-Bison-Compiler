   89                            | parameter parameters

   90 parameters: ε
   91           | COMMA none_or_newlines parameter parameters

   92 parameter: data_type ID

   93 method_body: ε
   94            | statement none_or_newlines method_body

   95 statement: ε
   96          | method_call
   97          | if_statement
   98          | do_while_statement
   99          | for_statement
  100          | switch_statement
  101          | return_statement
  102          | break_statement
  103          | print_statement
  104          | exp SEMICOLON
  105          | relational_exp SEMICOLON
  106          | DQ_STRING_DQ SEMICOLON
  107          | variable_declaration SEMICOLON
  108          | method_declaration
  109          | object_creation
  110          | variable_reference SEMICOLON
  111          | member_access

  112 assignment_statement: data_type ID ASSIGN exp
  113                     | data_type ID ASSIGN variable_reference

  114 method_call: METHOD_ID none_or_newlines none_or_multiple_arguments none_or_newlines RP SEMICOLON

  115 none_or_multiple_arguments: ε
  116                           | parameter arguments
  117                           | variable_reference arguments

  118 arguments: ε
  119          | COMMA none_or_newlines parameter arguments
  120          | COMMA none_or_newlines variable_reference arguments

  121 if_statement: IF LP none_or_newlines if_elif_parenthesis_statement none_or_newlines RP LCB none_or_newlines statement none_or_newlines RCB none_or_newlines none_or_multiple_elif none_or_newlines none_or_one_else

  122 if_elif_parenthesis_statement: exp
  123                              | relational_exp
  124                              | variable_reference
  125                              | method_call
  126                              | boolean

  127 none_or_multiple_elif: ε
  128                      | ELIF LP if_elif_parenthesis_statement RP LCB none_or_newlines statement none_or_newlines RCB none_or_multiple_elif

  129 none_or_one_else: ε
  130                 | ELSE LCB none_or_newlines statement none_or_newlines RCB

  131 do_while_statement: DO LCB none_or_newlines statement none_or_newlines RCB WHILE LP none_or_newlines relational_exp none_or_newlines RP SEMICOLON
  132                   | DO LCB none_or_newlines statement none_or_newlines RCB WHILE LP none_or_newlines variable_reference none_or_newlines RP SEMICOLON

  133 for_statement: FOR LP none_or_newlines first_and_third_loop_statement SEMICOLON none_or_newlines second_loop_statement SEMICOLON none_or_newlines first_and_third_loop_statement none_or_newlines RP LCB none_or_newlines statement none_or_newlines RCB

  134 first_and_third_loop_statement: ε
  135                               | assignment_statement
  136                               | variable_declaration

  137 second_loop_statement: ε
  138                      | relational_exp

  139 switch_statement: SWITCH LP none_or_newlines exp none_or_newlines RP LCB none_or_newlines one_or_more_cases none_or_newlines default_case none_or_newlines RCB
  140                 | SWITCH LP none_or_newlines SQ_ANYCHAR_SQ none_or_newlines RP LCB none_or_newlines one_or_more_cases none_or_newlines default_case none_or_newlines RCB

  141 default_case: ε
  142             | DEFAULT COLON none_or_newlines statement

  143 one_or_more_cases: cases none_or_newlines multiple_cases

  144 multiple_cases: ε
  145               | cases none_or_newlines multiple_cases

  146 cases: CASE case_expression COLON none_or_newlines statement

  147 case_expression: CONST
  148                | SQ_ANYCHAR_SQ

  149 return_statement: RETURN exp SEMICOLON
  150                 | RETURN variable_reference SEMICOLON
  151                 | RETURN method_call SEMICOLON

  152 break_statement: BREAK SEMICOLON

  153 print_statement: PRINT LP DQ_STRING_DQ single_or_multiple_variables RP SEMICOLON

  154 single_or_multiple_variables: ε
  155                             | COMMA ID single_or_multiple_variables

  156 exp: exp_int
  157    | exp_double

  158 exp_int: term_int
  159        | exp_int ADD term_int
  160        | exp_int SUB term_int
  161        | error

  162 term_int: factor_int
  163         | term_int MUL factor_int
  164         | term_int DIV factor_int
  165         | term_int MOD factor_int
  166         | term_int POW factor_int

  167 factor_int: primary_int
  168           | LP exp_int RP

  169 exp_double: term_double
  170           | exp_double ADD term_double
  171           | exp_double SUB term_double
  172           | error

  173 term_double: factor_double
  174            | term_double MUL factor_double
  175            | term_double DIV factor_double
  176            | term_double MOD factor_double
  177            | term_double POW factor_double

  178 factor_double: primary_double
  179              | LP exp_double RP

  180 relational_exp: relational_factor
  181               | relational_exp EQ relational_factor
  182               | relational_exp NEQ relational_factor
  183               | relational_exp LT relational_factor
  184               | relational_exp GT relational_factor
  185               | relational_exp LE relational_factor
  186               | relational_exp GE relational_factor

  187 relational_factor: logical_term
  188                  | relational_factor AND logical_term
  189                  | relational_factor OR logical_term

  190 logical_term: unary
  191             | NOT unary
  192             | LP relational_exp RP

  193 unary: primary_int
  194      | ADD primary_int
  195      | SUB primary_int

  196 primary_int: CONST
  197            | variable_reference

  198 primary_double: DOUBLE_CONST
  199               | variable_reference

  200 $@8: ε

  201 object_creation: CLASS_ID ID ASSIGN NEW CLASS_ID $@8 LP RP SEMICOLON

  202 member_access: ID DOT member_access_body none_or_newlines

  203 member_access_body: ID SEMICOLON
  204                   | method_call

  205 access_modifier: PUBLIC
  206                | PRIVATE

  207 boolean: TRUE
  208        | FALSE

  209 data_type: ε
  210          | INTEGER
  211          | CHAR
  212          | DOUBLE
  213          | BOOLEAN
  214          | STRING
  215          | VOID

  216 none_or_newlines: ε
  217                 | NEWLINE none_or_newlines


