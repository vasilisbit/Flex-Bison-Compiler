  126 none_or_multiple_elif: ε
  127                      | ELIF LP if_elif_parenthesis_statement RP LCB none_or_newlines statement none_or_newlines RCB none_or_multiple_elif

  128 none_or_one_else: ε
  129                 | ELSE LCB none_or_newlines statement none_or_newlines RCB

  130 do_while_statement: DO LCB none_or_newlines statement none_or_newlines RCB WHILE LP none_or_newlines relational_exp none_or_newlines RP SEMICOLON
  131                   | DO LCB none_or_newlines statement none_or_newlines RCB WHILE LP none_or_newlines variable_reference none_or_newlines RP SEMICOLON

  132 for_statement: FOR LP none_or_newlines first_and_third_loop_statement SEMICOLON none_or_newlines second_loop_statement SEMICOLON none_or_newlines first_and_third_loop_statement none_or_newlines RP LCB none_or_newlines statement none_or_newlines RCB

  133 first_and_third_loop_statement: ε
  134                               | assignment_statement
  135                               | variable_declaration

  136 second_loop_statement: ε
  137                      | relational_exp

  138 switch_statement: SWITCH LP none_or_newlines exp none_or_newlines RP LCB none_or_newlines one_or_more_cases none_or_newlines default_case none_or_newlines RCB
  139                 | SWITCH LP none_or_newlines SQ_ANYCHAR_SQ none_or_newlines RP LCB none_or_newlines one_or_more_cases none_or_newlines default_case none_or_newlines RCB

  140 default_case: ε
  141             | DEFAULT COLON none_or_newlines statement

  142 one_or_more_cases: cases none_or_newlines multiple_cases

  143 multiple_cases: ε
  144               | cases none_or_newlines multiple_cases

  145 cases: CASE case_expression COLON none_or_newlines statement

  146 case_expression: CONST
  147                | SQ_ANYCHAR_SQ

  148 return_statement: RETURN exp SEMICOLON
  149                 | RETURN variable_reference SEMICOLON
  150                 | RETURN method_call SEMICOLON

  151 break_statement: BREAK SEMICOLON

  152 print_statement: PRINT LP DQ_STRING_DQ single_or_multiple_variables RP SEMICOLON

  153 single_or_multiple_variables: ε
  154                             | COMMA ID single_or_multiple_variables

  155 exp: factor
  156    | exp ADD factor
  157    | exp SUB factor

  158 factor: term
  159       | factor MUL term
  160       | factor DIV term
  161       | factor MOD term

  162 term: unary
  163     | term POW unary

  164 relational_exp: relational_factor
  165               | relational_exp EQ relational_factor
  166               | relational_exp NEQ relational_factor
  167               | relational_exp LT relational_factor
  168               | relational_exp GT relational_factor
  169               | relational_exp LE relational_factor
  170               | relational_exp GE relational_factor

  171 relational_factor: logical_term
  172                  | relational_factor AND logical_term
  173                  | relational_factor OR logical_term

  174 logical_term: unary
  175             | NOT unary

  176 unary: primary
  177      | ADD primary
  178      | SUB primary

  179 primary: CONST
  180        | variable_reference
  181        | LP exp RP
  182        | LP relational_exp RP

  183 $@5: ε

  184 object_creation: CLASS_ID ID ASSIGN NEW CLASS_ID $@5 LP RP SEMICOLON

  185 $@6: ε

  186 member_access: ID DOT member_access_body $@6 none_or_newlines

  187 member_access_body: ID SEMICOLON
