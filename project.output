Grammar

    0 $accept: program $end

    1 program: ε
    2        | class_declaration none_or_newlines program
    3        | statement none_or_newlines program
    4        | error NEWLINE program

    5 $@1: ε

    6 class_declaration: access_modifier CLASS CLASS_ID LCB $@1 none_or_newlines class_body none_or_newlines RCB

    7 $@2: ε

    8 class_declaration: CLASS CLASS_ID LCB $@2 none_or_newlines class_body none_or_newlines RCB

    9 class_body: ε
   10           | class_declaration none_or_newlines class_body
   11           | statement none_or_newlines class_body

   12 identifier_list: INTEGER identifier_list_int
   13                | STRING identifier_list_string
   14                | CHAR identifier_list_char
   15                | DOUBLE identifier_list_double
   16                | BOOLEAN identifier_list_boolean
   17                | VAR identifier_list_variable

   18 identifier_list_int: ID
   19                    | ID COMMA identifier_list_int

   20 identifier_list_string: ID
   21                       | ID COMMA identifier_list_string

   22 identifier_list_char: ID
   23                     | ID COMMA identifier_list_char

   24 identifier_list_double: ID
   25                       | ID COMMA identifier_list_double

   26 identifier_list_boolean: ID
   27                        | ID COMMA identifier_list_boolean

   28 identifier_list_variable: ID
   29                         | ID COMMA identifier_list_variable

   30 assignment_list: INTEGER assignment_list_int
   31                | STRING assignment_list_string
   32                | CHAR assignment_list_char
   33                | DOUBLE assignment_list_double
   34                | BOOLEAN assignment_list_boolean
   35                | VAR assignment_list_variable
   36                | VAR assignment_list_method
   37                | VAR assignment_list_object

   38 assignment_list_int: ID ASSIGN exp_int
   39                    | ID ASSIGN exp_int COMMA assignment_list_int

   40 assignment_list_string: ID ASSIGN DQ_STRING_DQ
   41                       | ID ASSIGN DQ_STRING_DQ COMMA assignment_list_string

   42 assignment_list_char: ID ASSIGN SQ_ANYCHAR_SQ
   43                     | ID ASSIGN SQ_ANYCHAR_SQ COMMA assignment_list_char

   44 assignment_list_double: ID ASSIGN exp_double
   45                       | ID ASSIGN exp_double COMMA assignment_list_double

   46 assignment_list_boolean: ID ASSIGN boolean
   47                        | ID ASSIGN boolean COMMA assignment_list_boolean

   48 assignment_list_variable: ID ASSIGN variable_reference
   49                         | ID ASSIGN variable_reference COMMA assignment_list_variable

   50 assignment_list_method: ID ASSIGN method_call
   51                       | ID ASSIGN method_call COMMA assignment_list_method

   52 assignment_list_object: ID ASSIGN NEW CLASS_ID
   53                       | ID ASSIGN NEW CLASS_ID COMMA assignment_list_object

   54 assignment_list_declared: assignment_list_int_declared
   55                         | assignment_list_string_declared
   56                         | assignment_list_char_declared
   57                         | assignment_list_double_declared
   58                         | assignment_list_boolean_declared
   59                         | assignment_list_variable_declared
   60                         | assignment_list_method_declared
   61                         | assignment_list_object_declared

   62 assignment_list_int_declared: ID ASSIGN exp_int
   63                             | ID ASSIGN exp_int COMMA assignment_list_int_declared

   64 assignment_list_string_declared: ID ASSIGN DQ_STRING_DQ
   65                                | ID ASSIGN DQ_STRING_DQ COMMA assignment_list_string_declared

   66 assignment_list_char_declared: ID ASSIGN SQ_ANYCHAR_SQ
   67                              | ID ASSIGN SQ_ANYCHAR_SQ COMMA assignment_list_char_declared

   68 assignment_list_double_declared: ID ASSIGN exp_double
   69                                | ID ASSIGN exp_double COMMA assignment_list_double_declared

   70 assignment_list_boolean_declared: ID ASSIGN boolean
   71                                 | ID ASSIGN boolean COMMA assignment_list_boolean_declared

   72 assignment_list_variable_declared: ID ASSIGN variable_reference
   73                                  | ID ASSIGN variable_reference COMMA assignment_list_variable_declared

   74 assignment_list_method_declared: ID ASSIGN method_call
   75                                | ID ASSIGN method_call COMMA assignment_list_method_declared

   76 assignment_list_object_declared: ID ASSIGN NEW CLASS_ID
   77                                | ID ASSIGN NEW CLASS_ID COMMA assignment_list_object_declared

   78 variable_declaration: identifier_list
   79                     | access_modifier identifier_list
   80                     | access_modifier assignment_list
   81                     | assignment_list
   82                     | assignment_list_declared

   83 variable_reference: ID

   84 variable_reference_int: ID

   85 variable_reference_double: ID

   86 $@3: ε

   87 method_declaration: access_modifier data_type ID LP $@3 none_or_newlines none_or_multiple_parameters none_or_newlines RP LCB none_or_newlines method_body none_or_newlines RCB

   88 $@4: ε

   89 method_declaration: data_type ID LP $@4 none_or_newlines none_or_multiple_parameters none_or_newlines RP LCB none_or_newlines method_body none_or_newlines RCB

   90 none_or_multiple_parameters: ε
   91                            | parameter parameters

   92 parameters: ε
   93           | COMMA none_or_newlines parameter parameters

   94 parameter: data_type ID

   95 method_body: ε
   96            | statement none_or_newlines method_body

   97 statement: ε
   98          | method_call
   99          | if_statement
  100          | do_while_statement
  101          | for_statement
  102          | switch_statement
  103          | return_statement
  104          | break_statement
  105          | print_statement
  106          | exp SEMICOLON
  107          | relational_exp SEMICOLON
  108          | DQ_STRING_DQ SEMICOLON
  109          | variable_declaration SEMICOLON
  110          | method_declaration
  111          | object_creation
  112          | variable_reference SEMICOLON
  113          | member_access

  114 assignment_statement: data_type ID ASSIGN exp
  115                     | data_type ID ASSIGN variable_reference

  116 method_call: ID LP none_or_newlines none_or_multiple_arguments none_or_newlines RP SEMICOLON

  117 none_or_multiple_arguments: ε
  118                           | parameter arguments
  119                           | variable_reference arguments

  120 arguments: ε
  121          | COMMA none_or_newlines parameter arguments
  122          | COMMA none_or_newlines variable_reference arguments

  123 if_statement: IF LP none_or_newlines if_elif_parenthesis_statement none_or_newlines RP LCB none_or_newlines statement none_or_newlines RCB none_or_newlines none_or_multiple_elif none_or_newlines none_or_one_else

  124 if_elif_parenthesis_statement: exp
  125                              | relational_exp
  126                              | variable_reference
  127                              | method_call
  128                              | boolean

  129 none_or_multiple_elif: ε
  130                      | ELIF LP if_elif_parenthesis_statement RP LCB none_or_newlines statement none_or_newlines RCB none_or_multiple_elif

  131 none_or_one_else: ε
  132                 | ELSE LCB none_or_newlines statement none_or_newlines RCB

  133 do_while_statement: DO LCB none_or_newlines statement none_or_newlines RCB WHILE LP none_or_newlines relational_exp none_or_newlines RP SEMICOLON
  134                   | DO LCB none_or_newlines statement none_or_newlines RCB WHILE LP none_or_newlines variable_reference none_or_newlines RP SEMICOLON

  135 for_statement: FOR LP none_or_newlines first_and_third_loop_statement SEMICOLON none_or_newlines second_loop_statement SEMICOLON none_or_newlines first_and_third_loop_statement none_or_newlines RP LCB none_or_newlines statement none_or_newlines RCB

  136 first_and_third_loop_statement: ε
  137                               | assignment_statement
  138                               | variable_declaration

  139 second_loop_statement: ε
  140                      | relational_exp

  141 switch_statement: SWITCH LP none_or_newlines exp none_or_newlines RP LCB none_or_newlines one_or_more_cases none_or_newlines default_case none_or_newlines RCB
  142                 | SWITCH LP none_or_newlines SQ_ANYCHAR_SQ none_or_newlines RP LCB none_or_newlines one_or_more_cases none_or_newlines default_case none_or_newlines RCB

  143 default_case: ε
  144             | DEFAULT COLON none_or_newlines statement

  145 one_or_more_cases: cases none_or_newlines multiple_cases

  146 multiple_cases: ε
  147               | cases none_or_newlines multiple_cases

  148 cases: CASE case_expression COLON none_or_newlines statement

  149 case_expression: CONST
  150                | SQ_ANYCHAR_SQ

  151 return_statement: RETURN exp SEMICOLON
  152                 | RETURN variable_reference SEMICOLON
  153                 | RETURN method_call SEMICOLON

  154 break_statement: BREAK SEMICOLON

  155 print_statement: PRINT LP DQ_STRING_DQ single_or_multiple_variables RP SEMICOLON

  156 single_or_multiple_variables: ε
  157                             | COMMA ID single_or_multiple_variables

  158 exp: exp_int
  159    | exp_double

  160 exp_int: term_int
  161        | exp_int ADD term_int
  162        | exp_int SUB term_int

  163 term_int: factor_int
  164         | term_int MUL factor_int
  165         | term_int DIV factor_int
  166         | term_int MOD factor_int
  167         | term_int POW factor_int

  168 factor_int: primary_int
  169           | LP exp_int RP

  170 exp_double: term_double
  171           | exp_double ADD term_double
  172           | exp_double SUB term_double

  173 term_double: factor_double
  174            | term_double MUL factor_double
  175            | term_double DIV factor_double
  176            | term_double MOD factor_double
  177            | term_double POW factor_double

  178 factor_double: primary_double
  179              | LP exp_double RP

  180 relational_exp: relational_factor
  181               | relational_exp EQ relational_factor
  182               | relational_exp NEQ relational_factor
  183               | relational_exp LT relational_factor
  184               | relational_exp GT relational_factor
  185               | relational_exp LE relational_factor
  186               | relational_exp GE relational_factor

  187 relational_factor: logical_term
  188                  | relational_factor AND logical_term
  189                  | relational_factor OR logical_term

  190 logical_term: unary
  191             | NOT unary
  192             | LP relational_exp RP

  193 unary: primary_int
  194      | ADD primary_int
  195      | SUB primary_int

  196 primary_int: CONST
  197            | variable_reference_int

  198 primary_double: DOUBLE_CONST
  199               | variable_reference_double

  200 $@5: ε

  201 object_creation: CLASS_ID ID ASSIGN NEW CLASS_ID $@5 LP RP SEMICOLON

  202 $@6: ε

  203 member_access: ID DOT member_access_body $@6 none_or_newlines

  204 member_access_body: ID SEMICOLON
  205                   | method_call

  206 access_modifier: PUBLIC
  207                | PRIVATE

  208 boolean: TRUE
  209        | FALSE

  210 data_type: ε
  211          | INTEGER
  212          | CHAR
  213          | DOUBLE
  214          | BOOLEAN
  215          | STRING
  216          | VOID

  217 none_or_newlines: ε
  218                 | NEWLINE none_or_newlines


