Grammar

    0 $accept: program $end

    1 program: ε

    2 $@1: ε

    3 program: class_declaration none_or_newlines $@1 program

    4 $@2: ε

    5 program: statement none_or_newlines $@2 program

    6 $@3: ε

    7 program: error $@3 program

    8 $@4: ε

    9 class_declaration: access_modifier CLASS CLASS_ID LCB $@4 none_or_newlines class_body none_or_newlines RCB

   10 $@5: ε

   11 class_declaration: CLASS CLASS_ID LCB $@5 none_or_newlines class_body none_or_newlines RCB

   12 class_body: ε
   13           | class_declaration none_or_newlines class_body
   14           | statement none_or_newlines class_body

   15 identifier_list: INTEGER identifier_list_int
   16                | STRING identifier_list_string
   17                | CHAR identifier_list_char
   18                | DOUBLE identifier_list_double
   19                | BOOLEAN identifier_list_boolean
   20                | VAR identifier_list_variable

